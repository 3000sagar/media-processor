# Copy this to .env and fill in real values. Never commit the actual .env file.

# --- AWS / storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_RAW=media-raw-uploads
S3_BUCKET_PROCESSED=media-processed
CLOUDFRONT_DOMAIN=
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=

# --- Broker / cache (never use default/guest credentials) ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672//
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1

# --- Auth ---
# Comma-separated "key:owner_id" pairs. MVP-only storage — see DECISIONS_NEEDED.md.
API_KEY_HEADER_NAME=X-API-Key
VALID_API_KEYS=

# --- Limits ---
MAX_UPLOAD_SIZE_MB=500
PRESIGNED_URL_EXPIRY_SECONDS=900
RATE_LIMIT_JOBS_PER_MINUTE=10
JOB_STATUS_TTL_SECONDS=86400
MAX_QUEUE_DEPTH_BEFORE_BACKPRESSURE=500

# --- Media safety ---
PILLOW_MAX_IMAGE_PIXELS=178956970
FFMPEG_ALLOWED_PROTOCOLS=file
FFMPEG_TIMEOUT_SECONDS=300
IMAGE_MAX_WIDTH=1920
IMAGE_COMPRESSION_QUALITY=85
VIDEO_OUTPUT_CODEC=libx264
VIDEO_OUTPUT_RESOLUTION=1280x720

# --- Moderation (see DECISIONS_NEEDED.md before setting this to anything but "none") ---
MODERATION_PROVIDER=none
MODERATION_CONFIDENCE_THRESHOLD=0.8

# --- Locking ---
JOB_LOCK_TTL_SECONDS=600
CONFIRM_IDEMPOTENCY_TTL_SECONDS=60
